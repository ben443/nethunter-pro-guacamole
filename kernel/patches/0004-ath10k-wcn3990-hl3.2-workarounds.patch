--- a/drivers/net/wireless/ath/ath10k/thermal.c	2025-10-28 10:03:05.000000000 +1000
+++ b/drivers/net/wireless/ath/ath10k/thermal.c	2026-09-27 04:48:28.216470105 +1000
@@ -130,6 +130,16 @@
 
 	lockdep_assert_held(&ar->conf_mutex);
 
+	/*
+	 * WCN3990 WLAN.HL.3.2 firmware advertises thermal throttling but
+	 * crashes (PC 0xb0008e20) on the quiet mode command.
+	 */
+	if (QCA_REV_WCN3990(ar)) {
+		ath10k_dbg(ar, ATH10K_DBG_MAC,
+			   "skip quiet mode for WCN3990 (known crash trigger)\n");
+		return;
+	}
+
 	if (!test_bit(WMI_SERVICE_THERM_THROT, ar->wmi.svc_map))
 		return;
 
--- a/drivers/net/wireless/ath/ath10k/mac.c	2025-10-28 10:03:05.000000000 +1000
