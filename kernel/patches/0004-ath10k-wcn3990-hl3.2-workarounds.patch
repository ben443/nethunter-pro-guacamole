@@ -3448,6 +3448,13 @@
 			 */
 			ch->passive |= ch->chan_radar;
 
+			/*
+			 * WCN3990 firmware fails to tune the radio for active
+			 * scans on 5GHz channels; passive scanning works.
+			 */
+			if (QCA_REV_WCN3990(ar) && band == NL80211_BAND_5GHZ)
+				ch->passive = true;
+
 			ch->freq = channel->center_freq;
 			ch->band_center_freq1 = channel->center_freq;
