+#if defined CONFIG_OF && defined CONFIG_INTERCONNECT
+/*
+ * Interconnect handling code.
+ *
+ * Here we handle the interconnects property of our "simple-framebuffer"
+ * dt node. The bootloader left the display engine scanning out of memory,
+ * but no driver votes for that memory bandwidth, so the interconnect
+ * framework drops it once its providers reach sync_state and scanout
+ * stalls. Keep every listed path voted for as long as we use the
+ * framebuffer.
+ */
+static void simpledrm_device_release_interconnects(void *res)
+{
+	struct simpledrm_device *sdev = res;
+	unsigned int i;
+
+	for (i = 0; i < sdev->icc_count; ++i)
+		icc_put(sdev->icc_paths[i]);
+}
+
+static int simpledrm_device_init_interconnects(struct simpledrm_device *sdev)
+{
+	struct drm_device *dev = &sdev->sysfb.dev;
+	struct platform_device *pdev = to_platform_device(dev->dev);
+	struct device_node *of_node = pdev->dev.of_node;
+	struct icc_path *path;
+	int count, i, ret;
+
+	if (dev_get_platdata(&pdev->dev) || !of_node)
+		return 0;
+
+	/* each path is a <source destination> pair of endpoints */
+	count = of_count_phandle_with_args(of_node, "interconnects",
+					   "#interconnect-cells");
+	if (count <= 0)
+		return 0;
+	count /= 2;
+
+	sdev->icc_paths = drmm_kcalloc(dev, count, sizeof(sdev->icc_paths[0]),
+				       GFP_KERNEL);
+	if (!sdev->icc_paths)
+		return -ENOMEM;
+
+	for (i = 0; i < count; ++i) {
+		path = of_icc_get_by_index(&pdev->dev, i);
+		if (IS_ERR(path)) {
+			ret = PTR_ERR(path);
+			goto err;
+		}
+		sdev->icc_paths[sdev->icc_count++] = path;
+
+		/* well above a 1440x3120@60 XRGB8888 scanout (~1.1 GB/s) */
+		ret = icc_set_bw(path, MBps_to_icc(3000), MBps_to_icc(6000));
+		if (ret)
+			goto err;
+	}
+
+	return devm_add_action_or_reset(&pdev->dev,
+					simpledrm_device_release_interconnects,
+					sdev);
+
+err:
+	simpledrm_device_release_interconnects(sdev);
+	sdev->icc_count = 0;
+	if (ret != -EPROBE_DEFER)
+		drm_err(dev, "failed to set up interconnect path %d: %d\n",
+			i, ret);
+	return ret;
+}
+#else
+static int simpledrm_device_init_interconnects(struct simpledrm_device *sdev)
+{
+	return 0;
+}
+#endif
+
