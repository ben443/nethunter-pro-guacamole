--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole.dts
@@ -74,6 +74,17 @@
 			no-map;
 			reg = <0 0x9C000000 0 (1440 * 3120 * 4)>;
 		};
+
+		/* Same location as the downstream OnePlus sm8150 kernels */
+		ramoops@a9800000 {
+			compatible = "ramoops";
+			reg = <0 0xa9800000 0 0x400000>;
+			record-size = <0x40000>;
+			console-size = <0x40000>;
+			ftrace-size = <0x40000>;
+			pmsg-size = <0x200000>;
+			ecc-size = <0>;
+		};
 	};
 };
 
@@ -124,6 +135,23 @@
 	status = "disabled";
 };
 
+/*
+ * The Adreno 640 doesn't depend on the display blocks: without MDSS the msm
+ * driver exposes it as a render-only device next to simpledrm. The zap
+ * shader is extracted from the vendor partition by droid-juicer.
+ */
+&gmu {
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+
+	zap-shader {
+		firmware-name = "qcom/sm8150/oneplus7/a640_zap.mbn";
+	};
+};
+
 /* i2c17 (touchscreen) lives on QUP 2, which needs its GPI DMA engine */
 &gpi_dma2 {
 	status = "okay";
