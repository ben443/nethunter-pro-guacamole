+/*
+ * Firmware carve-outs for the final (Android 12) OnePlus firmware, from the
+ * OEM overlay of the downstream 18821 device tree: its modem image needs a
+ * 160 MiB region (older firmware fit in 150 MiB), shifting everything after
+ * it up by 10 MiB.
+ */
+&mpss_mem {
+	reg = <0x0 0x8dc00000 0x0 0xa000000>;
+};
+
+&venus_mem {
+	reg = <0x0 0x97c00000 0x0 0x500000>;
+};
+
+&slpi_mem {
+	reg = <0x0 0x98100000 0x0 0x1400000>;
+};
+
+&ipa_fw_mem {
+	reg = <0x0 0x99500000 0x0 0x10000>;
+};
+
+&ipa_gsi_mem {
+	reg = <0x0 0x99510000 0x0 0x5000>;
+};
+
+&gpu_mem {
+	reg = <0x0 0x99515000 0x0 0x2000>;
+};
+
+&spss_mem {
+	reg = <0x0 0x99600000 0x0 0x100000>;
+};
+
+&cdsp_mem {
+	reg = <0x0 0x99700000 0x0 0x1400000>;
+};
+
+/*
+ * There is no MDSS/DSI support for this panel yet, so we run on the
+ * bootloader framebuffer. The dispcc driver reprograms the display PLLs at
+ * probe, which stops scanout, so leave it to the bootloader.
+ */
+&dispcc {
+	status = "disabled";
+};
+
+/* i2c17 (touchscreen) lives on QUP 2, which needs its GPI DMA engine */
+&gpi_dma2 {
+	status = "okay";
+};
+
+&qupv3_id_2 {
+	status = "okay";
+};
+
+&pm8150b_charger {
+	status = "okay";
+	monitored-battery = <&battery>;
+};
+
+&pm8150b_fg {
+	status = "okay";
+	monitored-battery = <&battery>;
+	power-supplies = <&pm8150b_charger>;
+};
+
+/* WCN3990 supplies, as in the downstream 18821 icnss node */
+&wifi {
+	vdd-0.8-cx-mx-supply = <&vreg_l1a_0p75>;
+	vdd-1.8-xo-supply = <&vreg_l7a_1p8>;
+	vdd-1.3-rfa-supply = <&vreg_l2c_1p3>;
+	vdd-3.3-ch0-supply = <&vreg_l11c_3p3>;
+};
+
+/*
+ * The s6sy761 driver has no reset-gpios support; hold the touch controller
+ * out of reset (active low) through its pin state instead.
+ */
+&tp_rst_active {
+	config {
+		output-high;
+	};
+};
+
 &i2c17 {
 	status = "okay";
 	clock-frequency = <400000>;
