# Config fragment merged on top of pmOS config-postmarketos-qcom-sm8150.aarch64

# Android bootloader needs a plain Image.gz, not an EFI zboot PE
# CONFIG_EFI_ZBOOT is not set

# Phosh/wlroots needs a DRM device; use simpledrm on the bootloader framebuffer
CONFIG_DRM_SIMPLEDRM=y
# CONFIG_FB_SIMPLE is not set

# USB WiFi adapters commonly used for monitor mode / injection
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_RTL8187=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7921U=m

# USB serial adapters
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
