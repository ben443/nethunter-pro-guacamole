+/*
+ * The output allocator lives on the backend's DRM device. When that is a
+ * display-only device (e.g. simpledrm) and rendering happens on a separate
+ * render node, it fails to allocate many offscreen buffer sizes (EINVAL),
+ * breaking thumbnails. A backend without a DRM device (headless, never
+ * started) makes wlr_allocator_autocreate() use the renderer's device.
+ */
+static struct wlr_allocator *
+get_offscreen_allocator (PhocRenderer *self)
+{
+  if (self->offscreen_allocator)
+    return self->offscreen_allocator;
+
+  if (!self->offscreen_backend) {
+    struct wl_display *wl_display = phoc_server_get_wl_display (phoc_server_get_default ());
+
+    self->offscreen_backend = wlr_headless_backend_create (wl_display_get_event_loop (wl_display));
+    if (!self->offscreen_backend)
+      return self->wlr_allocator;
+  }
+
+  self->offscreen_allocator = wlr_allocator_autocreate (self->offscreen_backend, self->wlr_renderer);
+  if (!self->offscreen_allocator) {
+    g_warning ("Failed to create offscreen allocator, using the output allocator");
+    return self->wlr_allocator;
+  }
+
+  return self->offscreen_allocator;
+}
