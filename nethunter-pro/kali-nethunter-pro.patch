diff --git a/devices/qcom/phosh-wip/usr/libexec/guacamole/droid-juicer-slot b/devices/qcom/phosh-wip/usr/libexec/guacamole/droid-juicer-slot
new file mode 100755
index 0000000..e52d837
--- /dev/null
+++ b/devices/qcom/phosh-wip/usr/libexec/guacamole/droid-juicer-slot
@@ -0,0 +1,11 @@
+#!/bin/sh
+# droid-juicer takes partitions without a slot suffix from slot a, and the
+# bootloader passes no androidboot.slot_suffix. Extract from the slot the
+# phone booted instead (qbootctl reads it from the GPT A/B attributes), so
+# the firmware matches that slot's bootloader and TrustZone.
+slot=$(qbootctl -c 2>/dev/null | sed -n 's/^Current slot: _\([ab]\)$/\1/p')
+if [ -z "$slot" ]; then
+	echo "droid-juicer-slot: can't detect the current slot, using slot a" >&2
+	slot=a
+fi
+exec /usr/bin/droid-juicer --device "oneplus,guacamole_$slot"
diff --git a/devices/qcom/phosh-wip/usr/libexec/guacamole/phosh-renderer b/devices/qcom/phosh-wip/usr/libexec/guacamole/phosh-renderer
new file mode 100755
index 0000000..89c986e
--- /dev/null
+++ b/devices/qcom/phosh-wip/usr/libexec/guacamole/phosh-renderer
@@ -0,0 +1,13 @@
+#!/bin/sh
+# Pick the renderer for phoc and the session: the Adreno 640 if its render
+# node shows up within ~10 s, otherwise software (pixman/cairo)
+node=/dev/dri/by-path/platform-2c00000.gpu-render
+out=/run/guacamole-phosh-renderer.env
+udevadm settle --timeout=10 || true
+i=0
+while [ ! -e "$node" ] && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done
+if [ -e "$node" ]; then
+	printf 'WLR_RENDERER=gles2\nWLR_RENDER_DRM_DEVICE=%s\n' "$(readlink -f "$node")" > "$out"
+else
+	printf 'WLR_RENDERER=pixman\nGSK_RENDERER=cairo\n' > "$out"
+fi
