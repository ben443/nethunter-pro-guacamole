+++ b/devices/qcom/phosh-wip/etc/udev/rules.d/60-remoteproc-no-coredump.rules
@@ -0,0 +1,4 @@
+# Don't dump remote processor memory (e.g. the 160 MiB modem region) when one
+# crashes: on SM8150 reading it can trip the XPU and force the whole phone into
+# Qualcomm crash-dump mode, instead of just restarting the remote processor.
+ACTION=="add", SUBSYSTEM=="remoteproc", ATTR{coredump}="disabled"
