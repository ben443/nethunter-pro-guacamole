index 0000000..0062623
--- /dev/null
+++ b/devices/qcom/droid-juicer/oneplus,guacamole_a.toml
@@ -0,0 +1,29 @@
+# Firmware from slot a: droid-juicer takes unsuffixed partitions from slot a,
+# so /usr/libexec/guacamole/droid-juicer-slot picks the file for the slot the
+# phone booted (the firmware must match that slot's bootloader/TrustZone).
+[juicer]
+firmware = [
+    { partition = "vendor_a", origin = "firmware", destination = "qcom/sm8150/oneplus7", files = [
+            { name = "a640_zap.mdt" },
+            { name = "ipa_fws.mdt" },
+        ] },
+    { partition = "modem_a", origin = "image", destination = "qcom/sm8150/oneplus7", files = [
+            { name = "adsp.mdt" },
+            { name = "adspr.jsn" },
+            { name = "adspua.jsn" },
+            { name = "cdsp.mdt" },
+            { name = "cdspr.jsn" },
+            { name = "modem.mdt" },
+            { name = "modemr.jsn" },
+            { name = "modemuw.jsn" },
+            { name = "slpi.mdt" },
+            { name = "slpir.jsn" },
+            { name = "slpius.jsn" },
+            { name = "venus.mdt" },
+            { name = "wlanmdsp.mbn" },
+        ] },
+    { partition = "bluetooth_a", origin = "image", destination = "qca", files = [
+            { name = "crbtfw21.tlv" },
+            { name = "crnv21.bin" },
+        ] },
+]
